      "changed_paths": ["glm-worker/internal/state/store.go"],
      "runner_steps": [
        {"lines": ["STATUS: IMPLEMENTED", "RISK: LOW", "SUMMARY: added persistent value", "REQUIREMENT_COVERAGE: covered", "TESTS: pass", "UNVERIFIED: none", "ARTIFACTS: none"]},
        {"lines": ["STATUS: PASS", "RISK: LOW", "SUMMARY: pass", "REQUIREMENT_COVERAGE: covered", "INVARIANTS: preserved", "TEST_EVIDENCE: ev", "ISSUES: none", "RESIDUAL_RISK: none", "TARGETS: none", "ARTIFACTS: none"]},
