      "entry": "new_task",
      "instruction_files": [
        "codex/instructions/worker/state-transitions.md",
        "codex/glm-worker/prompts/WORKER.md",
        "codex/glm-worker/prompts/REVIEWER.md"
      ],
      "changed_paths": ["glm-worker/internal/state/store.go"],
      "runner_steps": [
        {"lines": ["STATUS: IMPLEMENTED", "RISK: LOW", "SUMMARY: added persistent value", "REQUIREMENT_COVERAGE: covered", "TESTS: pass", "UNVERIFIED: none", "ARTIFACTS: none"]},
        {"lines": ["STATUS: PASS", "RISK: LOW", "SUMMARY: pass", "REQUIREMENT_COVERAGE: covered", "INVARIANTS: preserved", "TEST_EVIDENCE: ev", "ISSUES: none", "RESIDUAL_RISK: none", "TARGETS: none", "ARTIFACTS: none"]},
        {"lines": ["STATUS: NEEDS_SOL_REVIEW", "RISK: HIGH", "SUMMARY: review", "REQUIREMENT_COVERAGE: covered", "INVARIANTS: preserved", "TEST_EVIDENCE: ev", "ISSUES: i", "RESIDUAL_RISK: r", "TARGETS: t", "ARTIFACTS: none", "SOL_QUESTION: q"]}
      ],
      "expected_models": ["opus", "sonnet", "sonnet"],
      "expected_packet_status": "NEEDS_SOL_REVIEW",
      "expected_packet_risk": "HIGH",
      "expected_task_status": "waiting-sol-review",
      "must_not_pass": true
    },
