      "expected_actions": ["create_placeholder", "report_failure"],
      "expected_fallback_id": ""
    },
    {
      "id": "autoresume-success-response-without-id-not-success",
      "behavior": "成功応答でもautomation IDがなければ候補成功としない(障害1)",
      "resume_at": "2026-08-12T11:01:20Z",
      "existing_automation_id": "",
      "create_responses": ["Created automation in the app"],
      "update_responses": [],
      "delete_errors": [],
      "verifications": [],
      "expected_reserved": false,
      "expected_actions": ["create_placeholder", "report_failure"],
      "expected_fallback_id": ""
    },
    {
      "id": "autoresume-id-only-response-without-success-marker-not-success",
      "behavior": "明示成功markerのないIDのみの応答を作成失敗とする(障害1)",
      "resume_at": "2026-08-12T11:01:20Z",
