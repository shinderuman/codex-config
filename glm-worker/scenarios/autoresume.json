{
  "version": 1,
  "description": "glm-auto-resume.md予約契約のescaped bug corpus。automation tool応答・検証結果のfixture入力列に対し、internal/autoresume test内の契約実装が期待行動列(create/update/delete/verify/停止・成功報告可否)を決定論検証する。実障害5種(誤成功誤認・DTSTART付き即時create・placeholder残留・FAIL/UNAVAILABLE成功扱い・既存更新時新規placeholder)を必須scenarioで固定する。live model・network不使用。",
  "scenarios": [
    {
      "id": "autoresume-existing-automation-updates-same-id-no-placeholder",
      "behavior": "既存automationは同一ID直接updateで新規placeholderを作らない(障害5)",
      "resume_at": "2026-08-12T20:01:20+09:00",
      "existing_automation_id": "glm-worker-resume-testrepo12-12345678",
      "create_responses": [],
      "update_responses": ["Updated automation in the app. automation_id: glm-worker-resume-testrepo12-12345678, status ACTIVE"],
      "delete_errors": [],
      "verifications": [{"outcome": "PASS", "manual_app_confirmed": false}],
      "expected_reserved": true,
      "expected_actions": ["update_active:glm-worker-resume-testrepo12-12345678", "verify", "report_reserved"],
      "expected_fallback_id": ""
    },
    {
      "id": "autoresume-error-response-not-misread-as-success",
      "behavior": "error/invalid応答を作成失敗とする(障害1)",
      "resume_at": "2026-08-12T11:01:20Z",
      "existing_automation_id": "",
      "create_responses": ["Error: invalid arguments supplied to automation_update"],
      "update_responses": [],
      "delete_errors": [],
      "verifications": [],
      "expected_reserved": false,
      "expected_actions": ["create_placeholder", "report_failure"],
      "expected_fallback_id": ""
    },
    {
      "id": "autoresume-empty-response-not-misread-as-success",
      "behavior": "空応答を作成失敗とし第二段階へ進まない(障害1)",
      "resume_at": "2026-08-12T11:01:20Z",
      "existing_automation_id": "",
      "create_responses": ["   \n"],
      "update_responses": [],
      "delete_errors": [],
      "verifications": [],
      "expected_reserved": false,
      "expected_actions": ["create_placeholder", "report_failure"],
      "expected_fallback_id": ""
    },
    {
      "id": "autoresume-suggestion-card-response-not-success",
      "behavior": "候補カード表示応答を作成失敗とする(障害1)",
      "resume_at": "2026-08-12T11:01:20Z",
      "existing_automation_id": "",
      "create_responses": ["Rendered suggestion card for automation creation. suggested_create: glm-worker-resume-testrepo12-12345678"],
      "update_responses": [],
      "delete_errors": [],
      "verifications": [],
