      "expected_actions": ["create_placeholder", "update_active:auto-77ab", "delete:auto-77ab", "report_failure"],
      "expected_fallback_id": ""
    },
    {
      "id": "autoresume-update-failure-delete-also-fails-reports-id",
      "behavior": "削除も失敗した場合automation IDを手動fallback案内へ明示する(障害3)",
      "resume_at": "2026-08-12T11:01:20Z",
      "existing_automation_id": "",
      "create_responses": ["Created automation in the app. Automation ID: auto-c31d"],
      "update_responses": ["failed to update automation"],
      "delete_errors": ["automation delete tool call failed"],
      "verifications": [],
      "expected_reserved": false,
      "expected_actions": ["create_placeholder", "update_active:auto-c31d", "delete:auto-c31d", "report_failure"],
      "expected_fallback_id": "auto-c31d"
    },
    {
      "id": "autoresume-verify-fail-fail-closed-with-cleanup",
      "behavior": "verify FAILは再試行1回後も成功扱いせず新規作成分を削除する(障害4)",
      "resume_at": "2026-08-12T11:01:20Z",
      "existing_automation_id": "",
      "create_responses": ["Created automation in the app. Automation ID: auto-5e0f"],
      "update_responses": [
        "Updated automation in the app. automation_id: auto-5e0f, status ACTIVE",
