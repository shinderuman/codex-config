      "delete_errors": [""],
      "verifications": [
        {"outcome": "FAIL", "manual_app_confirmed": false},
        {"outcome": "FAIL", "manual_app_confirmed": false}
      ],
      "expected_reserved": false,
      "expected_actions": [
        "create_placeholder",
        "update_active:auto-5e0f",
        "verify",
        "update_active:auto-5e0f",
        "verify",
        "delete:auto-5e0f",
        "report_failure"
      ],
      "expected_fallback_id": ""
    },
    {
      "id": "autoresume-verify-fail-single-retry-recovers",
      "behavior": "verify FAIL後のupdate再試行は最大1回でPASSなら予約成功とする",
      "resume_at": "2026-08-12T11:01:20Z",
      "existing_automation_id": "",
      "create_responses": ["Created automation in the app. Automation ID: auto-8b44"],
      "update_responses": [
        "Updated automation in the app. automation_id: auto-8b44, status ACTIVE",
        "Updated automation in the app. automation_id: auto-8b44, status ACTIVE"
      ],
      "delete_errors": [],
      "verifications": [
        {"outcome": "FAIL", "manual_app_confirmed": false},
        {"outcome": "PASS", "manual_app_confirmed": false}
      ],
      "expected_reserved": true,
      "expected_actions": [
        "create_placeholder",
        "update_active:auto-8b44",
        "verify",
        "update_active:auto-8b44",
        "verify",
        "report_reserved"
      ],
      "expected_fallback_id": ""
    },
    {
      "id": "autoresume-verify-unavailable-unconfirmed-is-failure",
      "behavior": "UNAVAILABLEでapp確認不能なら予約成功としない(障害4)",
