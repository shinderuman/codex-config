      "behavior": "新規はDTSTARTなしPAUSED placeholder→応答ID→同一ID updateの二段階で即時DTSTART createを行わない(障害2)",
      "resume_at": "2026-08-12T19:01:20+08:00",
      "existing_automation_id": "",
      "create_responses": ["Created automation in the app. Automation ID: auto-9f2c.placeholder"],
      "update_responses": ["Updated automation in the app. automation_id: auto-9f2c.placeholder, status ACTIVE"],
      "delete_errors": [],
